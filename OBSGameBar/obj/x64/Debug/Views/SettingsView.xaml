<Page x:ConnectionId='1'
    x:Class="OBSGameBar.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OBSGameBar.Core.Models"
    xmlns:converters="using:OBSGameBar.Views.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:ConnectionStatusToBrushConverter x:Key="StatusToBrushConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/FluentResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="16" Spacing="16" MaxWidth="440">

            <!-- Settings Header -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Connection Settings" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Non-local security warning -->
            <Border x:ConnectionId='2' Background="{StaticResource WarningBadgeBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10"
                                                                                                                                   >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="16" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Warning: You are connecting to a remote host. Make sure your OBS WebSocket traffic is trusted."
                               FontSize="11" TextWrapping="Wrap" Foreground="#FFFDE68A" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Saved Notification Banner -->
            <Border x:ConnectionId='3' Background="{StaticResource SuccessBadgeBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="10"
                                                                                                                                        >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="14" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Settings saved and applied successfully!" FontSize="12" Foreground="#FFA7F3D0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- OBS Server Config Form -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="OBS WebSocket server" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:ConnectionId='19' Grid.Column="0" Header="OBS Host"                                             PlaceholderText="127.0.0.1" />
                        <TextBox x:ConnectionId='20' Grid.Column="1" Header="Port"                                             PlaceholderText="4455" />
                    </Grid>

                    <PasswordBox x:ConnectionId='14' x:Name="PasswordBoxInput" Header="WebSocket Password" PlaceholderText="••••••••"                                     />

                    <CheckBox x:ConnectionId='15' Content="Connect automatically on launch"                                                         FontSize="12" />

                    <!-- Test Connection Button & Status -->
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <Button x:ConnectionId='16' Style="{StaticResource SecondaryButtonStyle}"
                                                                                  
                                                                                                                                      
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing x:ConnectionId='18'                                                      Width="14" Height="14" Margin="0,0,4,0" />
                                <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:ConnectionId='17'                                                         
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                                                                                                                                  />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Safety & Confirmation Preferences -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Confirmations" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                    <ToggleSwitch x:ConnectionId='12' Header="Require confirmation before starting/stopping stream"                                                      FontSize="12" />
                    <ToggleSwitch x:ConnectionId='13' Header="Require confirmation before stopping recording"                                                      FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Configurable Hotkeys Overview -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Default hotkeys" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                    <ItemsControl x:ConnectionId='6'                                                      >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                  >
                                <Grid x:ConnectionId='8' Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:ConnectionId='10'                            FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock x:ConnectionId='11'                             FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource ControlBackgroundBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='9'                                    FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentTextBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Save & Reset Actions -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:ConnectionId='4' Style="{StaticResource SecondaryButtonStyle}"                                                  >
                    <TextBlock Text="Reset Defaults" />
                </Button>
                <Button x:ConnectionId='5' Style="{StaticResource PrimaryButtonStyle}"                                                 >
                    <TextBlock Text="Save Changes" />
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

