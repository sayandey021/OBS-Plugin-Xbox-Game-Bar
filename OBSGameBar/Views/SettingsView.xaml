<Page
    x:Class="OBSGameBar.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OBSGameBar.Core.Models"
    xmlns:converters="using:OBSGameBar.Views.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:ConnectionStatusToBrushConverter x:Key="StatusToBrushConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/FluentResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="16" Spacing="16" MaxWidth="440">

            <!-- Settings Header -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Connection Settings" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Non-local security warning -->
            <Border Background="{StaticResource WarningBadgeBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10"
                    Visibility="{x:Bind ViewModel.ShowNonLocalWarning, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="16" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Warning: You are connecting to a remote host. Make sure your OBS WebSocket traffic is trusted."
                               FontSize="11" TextWrapping="Wrap" Foreground="#FFFDE68A" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Saved Notification Banner -->
            <Border Background="{StaticResource SuccessBadgeBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="10"
                    Visibility="{x:Bind ViewModel.SavedNotificationVisible, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="14" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Settings saved and applied successfully!" FontSize="12" Foreground="#FFA7F3D0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- OBS Server Config Form -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="OBS WebSocket server" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Header="OBS Host" Text="{x:Bind ViewModel.Host, Mode=TwoWay}" PlaceholderText="127.0.0.1" />
                        <TextBox Grid.Column="1" Header="Port" Text="{x:Bind ViewModel.Port, Mode=TwoWay}" PlaceholderText="4455" />
                    </Grid>

                    <PasswordBox x:Name="PasswordBoxInput" Header="WebSocket Password" PlaceholderText="••••••••" PasswordChanged="OnPasswordChanged" />

                    <CheckBox Content="Connect automatically on launch" IsChecked="{x:Bind ViewModel.AutoConnect, Mode=TwoWay}" FontSize="12" />

                    <!-- Test Connection Button & Status -->
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.TestConnectionCommand}"
                                IsEnabled="{x:Bind ViewModel.IsTesting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}" Width="14" Height="14" Margin="0,0,4,0" />
                                <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{x:Bind ViewModel.TestStatusMessage, Mode=OneWay}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{x:Bind ViewModel.TestSuccessful, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Safety & Confirmation Preferences -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Confirmations" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                    <ToggleSwitch Header="Require confirmation before starting/stopping stream" IsOn="{x:Bind ViewModel.ConfirmStream, Mode=TwoWay}" FontSize="12" />
                    <ToggleSwitch Header="Require confirmation before stopping recording" IsOn="{x:Bind ViewModel.ConfirmRecord, Mode=TwoWay}" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Configurable Hotkeys Overview -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Default hotkeys" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Hotkeys, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HotkeyBinding">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind ActionName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource ControlBackgroundBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayCombination}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentTextBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Save & Reset Actions -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.ResetDefaultsCommand}">
                    <TextBlock Text="Reset Defaults" />
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.SaveSettingsCommand}">
                    <TextBlock Text="Save Changes" />
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
